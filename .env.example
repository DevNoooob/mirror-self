# Copy to .env and replace with long, unique values.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
MIRROR_OWNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Default RULE mode performs no model calls. Cloud LLM also needs API source grants.
MIRROR_EXTRACTION_MODE=RULE
MIRROR_MODEL_EGRESS_ENABLED=false
MIRROR_LLM_LOCAL=false
MIRROR_LLM_BASE_URL=https://api.openai.com/v1
MIRROR_LLM_MODEL=
MIRROR_LLM_API_KEY=
MIRROR_LLM_TIMEOUT=30s
MIRROR_LLM_BATCH_CHARS=16000
MIRROR_LLM_BATCH_MESSAGES=30
# Single-owner UUID (not a credential)
MIRROR_OWNER_ID=11111111-1111-4111-8111-111111111111

# Embedding is separate from LLM extraction, disabled unless explicitly configured.
# LOCAL accepts only loopback; provision model separately on Ubuntu, no auto-download.
MIRROR_EMBEDDING_MODE=DISABLED
MIRROR_EMBEDDING_BASE_URL=http://127.0.0.1:8090/v1
MIRROR_EMBEDDING_MODEL=bge-m3
# Set a pinned artifact/tokenizer/preprocessing revision before enabling LOCAL.
MIRROR_EMBEDDING_VERSION=unconfigured
MIRROR_EMBEDDING_API_KEY=
MIRROR_EMBEDDING_TIMEOUT=15s
